    {
      "parameters": {
        "jsCode": "const rssItems = $input.all();\nconst sheetItems = $('Get row(s) in sheet').all();\n\nconst existingIds = new Set(\n  sheetItems\n    .map(item => item.json['Video ID'])\n    .filter(Boolean)\n);\n\nconst newItems = rssItems.filter(item => {\n  const videoId = item.json.id;\n  return !existingIds.has(videoId);\n});\n\nif (newItems.length === 0) {\n  return [\n    {\n      json: {\n        isNew: false\n      }\n    }\n  ];\n}\n\nreturn newItems.map(item => ({\n  json: {\n    ...item.json,\n    isNew: true\n  }\n}));;"
      },
